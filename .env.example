# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Cloud API Webhook Verify Token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_secure_random_64char_webhook_token
# App Secret Meta (signature X-Hub-Signature-256 des webhooks WhatsApp)
WHATSAPP_APP_SECRET=your_meta_app_secret

# Scripts d'administration (node scripts/create-admin.mjs)
# ADMIN_EMAIL=admin@klickdrive.ma
# ADMIN_PASSWORD=choose_a_strong_password
